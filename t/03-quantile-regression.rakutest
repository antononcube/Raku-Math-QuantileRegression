use v6.d;
use Math::QuantileRegression;
use Test;

my @linear-data = [[-2, -4], [-1, -1], [0, 2], [1, 5], [2, 8]];
my @probabilities = 0.25, 0.5, 0.75;

# 1
my @piece-fits = quantile-regression(
    @linear-data,
    2,
    @probabilities,
    :interpolation-order(1),
);
is @piece-fits.elems, @probabilities.elems,
    'an integer knot specification returns one fit per probability';

# 2    
is-approx @piece-fits[1](1), 5,
    'integer knot spline fit reproduces the linear data';

# 3
my @knot-fits = quantile-regression(
    @linear-data,
    :knots([-2, 0, 2]),
    :probabilities([0.5]),
    :interpolation-order(1),
);
is @knot-fits.elems, 1, 'an explicit knot list is accepted';

# 4
is-approx @knot-fits[0](2), 8,
    'explicit-knot spline basis handles its right endpoint';

# 5
my @response-fits = quantile-regression(
    [1, 3, 5, 7],
    [0, 1, 2, 3],
    [0.5],
    :interpolation-order(1),
);
is @response-fits.elems, 1, 'a response vector is converted to indexed data';

# 6
is-approx @response-fits[0](2), 5,
    'response-vector spline fit uses successive integer predictors';

done-testing;
